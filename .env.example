# Copiar a .env y ajustar. Ningún valor real de producción va al repositorio.

# Clave secreta de Django. Obligatoria cuando DJANGO_DEBUG=false.
# Generar una: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# true en desarrollo, false en producción
DJANGO_DEBUG=true

# Hosts permitidos, separados por coma. En desarrollo con DEBUG=true se permite cualquiera.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes permitidos para CORS y CSRF, separados por coma.
# Ionic en desarrollo: http://localhost:8100 ; Capacitor: capacitor://localhost, https://localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8100,capacitor://localhost,https://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://healthlab-sn84.onrender.com

# Base de datos. Vacío = SQLite local (solo desarrollo).
# PostgreSQL: postgres://usuario:clave@localhost:5432/healthlab
DATABASE_URL=

# Carpeta de archivos subidos e informes (fuera del repositorio en producción)
DJANGO_MEDIA_ROOT=

# Seguridad HTTPS (solo producción)
DJANGO_SECURE_SSL_REDIRECT=false

# Límite de intentos de login por usuario/IP (formato DRF: n/min, n/hour)
DJANGO_LOGIN_THROTTLE=5/min

# Muestra /api/docs/ (Swagger) aunque DJANGO_DEBUG=false
DJANGO_EXPONER_DOCS=false

# En Render no hace falta poner el dominio del servicio en DJANGO_ALLOWED_HOSTS ni en
# DJANGO_CSRF_TRUSTED_ORIGINS: se toma de RENDER_EXTERNAL_HOSTNAME (ver render.yaml).
